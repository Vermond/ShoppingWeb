# PostgreSQL connection string used by the NestJS server.
NODE_ENV=development
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Optional. Use a different port when the frontend uses 3000.
PORT=3001

# Public frontend origin used in email verification links.
FRONTEND_URL=http://localhost:3000

# Resend API key. Keep this value out of source control.
RESEND_API_KEY=re_xxxxxxxxx

# Sender address configured in Resend. The onboarding address is suitable for development.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional display name shown in the sender field.
RESEND_FROM_NAME=ShoppingWeb

# Verification token lifetime in minutes. 1440 minutes equals 24 hours.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# JWT signing secrets. Use different randomly generated values in each environment.
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_chars
AUTH_REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret_at_least_32_chars

# Token lifetimes. Supported units are s, m, h, and d.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# Cookie names and local/production cookie policy.
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

AUTH_RATE_LIMIT_LOGIN_LIMIT=5
AUTH_RATE_LIMIT_LOGIN_TTL_SECONDS=60
AUTH_RATE_LIMIT_RESEND_LIMIT=3
AUTH_RATE_LIMIT_RESEND_TTL_SECONDS=900
AUTH_RATE_LIMIT_SIGNUP_LIMIT=10
AUTH_RATE_LIMIT_SIGNUP_TTL_SECONDS=3600
AUTH_RATE_LIMIT_VERIFY_LIMIT=10
AUTH_RATE_LIMIT_VERIFY_TTL_SECONDS=60
AUTH_RATE_LIMIT_REFRESH_LIMIT=30
AUTH_RATE_LIMIT_REFRESH_TTL_SECONDS=60
