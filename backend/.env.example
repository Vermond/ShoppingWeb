# PostgreSQL connection string used by the NestJS server.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Optional. Use a different port when the frontend uses 3000.
PORT=3001

# Public frontend origin used in email verification links.
FRONTEND_URL=http://localhost:3000

# Resend API key. Keep this value out of source control.
RESEND_API_KEY=re_xxxxxxxxx

# Sender address configured in Resend. The onboarding address is suitable for development.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional display name shown in the sender field.
RESEND_FROM_NAME=ShoppingWeb

# Verification token lifetime in minutes. 1440 minutes equals 24 hours.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
